# Local development — copy to .env (do not commit .env)
DATABASE_URL=sqlite+aiosqlite:///./impactflow.db
# Production: postgresql+asyncpg://user:pass@host:5432/impactflow
SECRET_KEY=your-super-secret-jwt-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
OPENAI_API_KEY=
ENVIRONMENT=development
API_PREFIX=/api/v1
# Set AUTH_BYPASS=true for local dev without JWT (optional)
AUTH_BYPASS=true
CORS_ORIGINS=http://localhost:5173
WEBSOCKET_ENABLED=false
DEMO_MODE_ENABLED=true
